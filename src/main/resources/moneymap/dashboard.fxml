<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<VBox id="dashboardView" spacing="14" styleClass="page" xmlns="http://javafx.com/javafx/17.0.7" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets top="42" right="48" bottom="42" left="48" /></padding>
    <Label text="Dashboard" styleClass="page-title" />
    <Label text="Your monthly summary will appear here once you record transactions." styleClass="muted" wrapText="true" />
    <VBox spacing="8" styleClass="empty-panel">
        <Label text="No transactions yet" styleClass="section-title" />
        <Label text="Start by adding an income or expense in Transactions. MoneyMap will show your balance, category spending, and budget status here." styleClass="muted" wrapText="true" />
    </VBox>
</VBox>

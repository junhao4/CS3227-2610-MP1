<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane fx:id="shell" xmlns="http://javafx.com/javafx/17.0.7" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cs3227.moneymap.ui.ApplicationController" styleClass="app-shell">
    <left>
        <VBox prefWidth="245" spacing="8" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding><Insets top="28" right="18" bottom="24" left="18" /></padding>
            <Label text="MoneyMap" styleClass="brand" />
            <Label text="Student budget tracker" styleClass="sidebar-caption" />
            <Separator />
            <Label text="WORKSPACE" styleClass="nav-heading" />
            <Button id="dashboardButton" maxWidth="Infinity" text="Dashboard" onAction="#showDashboard" styleClass="nav-button" />
            <Button id="transactionsButton" maxWidth="Infinity" text="Transactions" onAction="#showTransactions" styleClass="nav-button" />
            <Button id="categoriesAndBudgetsButton" maxWidth="Infinity" text="Categories and Budgets" onAction="#showCategoriesAndBudgets" styleClass="nav-button" />
            <VBox VBox.vgrow="ALWAYS" />
            <Button id="dataAndSettingsButton" maxWidth="Infinity" text="Data and Settings" onAction="#showDataAndSettings" styleClass="nav-button, secondary" />
            <Label text="PRODUCTION SHELL · v0.1" styleClass="sidebar-footer" />
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" spacing="12" styleClass="empty-state">
            <Label text="Loading MoneyMap" styleClass="empty-title" />
            <Label text="Choose an area from the navigation." styleClass="muted" />
        </VBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<VBox id="transactionsView" spacing="14" styleClass="page" xmlns="http://javafx.com/javafx/17.0.7" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets top="42" right="48" bottom="42" left="48" /></padding>
    <Label text="Transactions" styleClass="page-title" />
    <Label text="Record and review your income and expenses here." styleClass="muted" />
    <VBox spacing="8" styleClass="empty-panel">
        <Label text="No transactions recorded" styleClass="section-title" />
        <Label text="Transaction entry, filtering, search, editing, and deletion will be available in this area." styleClass="muted" wrapText="true" />
    </VBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="24" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" styleClass="page">
    <padding><Insets top="34" right="42" bottom="34" left="42" /></padding>
    <VBox spacing="4"><Label text="August at a glance" styleClass="page-title"/><Label text="A visual check-in on where your money is going." styleClass="muted"/></VBox>
    <VBox styleClass="hero-card" spacing="8"><Label text="You have 426.80 left to spend" styleClass="hero-title"/><Label text="47% of your planned spending remains." styleClass="hero-subtitle"/><ProgressBar maxWidth="Infinity" progress="0.47" styleClass="hero-progress"/></VBox>
    <HBox spacing="18">
        <VBox HBox.hgrow="ALWAYS" styleClass="panel chart-panel"><Label text="Budget vs spending" styleClass="section-title"/><HBox alignment="CENTER_LEFT" spacing="10"><Label prefWidth="95" text="Food"/><ProgressBar HBox.hgrow="ALWAYS" maxWidth="Infinity" progress="0.61" styleClass="budget-progress"/><Label prefWidth="70" text="184 / 300"/></HBox><HBox alignment="CENTER_LEFT" spacing="10"><Label prefWidth="95" text="Transport"/><ProgressBar HBox.hgrow="ALWAYS" maxWidth="Infinity" progress="0.77" styleClass="budget-progress-warning"/><Label prefWidth="70" text="92 / 120"/></HBox><HBox alignment="CENTER_LEFT" spacing="10"><Label prefWidth="95" text="Entertainment"/><ProgressBar HBox.hgrow="ALWAYS" maxWidth="Infinity" progress="1.0" styleClass="budget-progress-over"/><Label prefWidth="70" text="197 / 180" styleClass="danger-text"/></HBox><HBox alignment="CENTER_LEFT" spacing="10"><Label prefWidth="95" text="Bills"/><ProgressBar HBox.hgrow="ALWAYS" maxWidth="Infinity" progress="0.0" styleClass="budget-progress"/><Label prefWidth="70" text="0 / 200"/></HBox></VBox>
        <VBox prefWidth="245" spacing="10" styleClass="panel"><Label text="Quick totals" styleClass="section-title"/><Label text="Income" styleClass="card-label"/><Label text="1,200.00" styleClass="metric-value small"/><Label text="Expenses" styleClass="card-label"/><Label text="473.20" styleClass="metric-value small"/><Label text="Net balance" styleClass="card-label"/><Label text="726.80" styleClass="positive metric-value small"/></VBox>
    </HBox>
    <HBox spacing="12"><VBox HBox.hgrow="ALWAYS" styleClass="callout"><Label text="Largest category" styleClass="card-label"/><Label text="Entertainment · 197" styleClass="section-title"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="callout"><Label text="Next action" styleClass="card-label"/><Label text="Review 3 uncategorised expenses" styleClass="section-title"/></VBox></HBox>
</VBox>

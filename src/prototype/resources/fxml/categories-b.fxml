<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="20" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" styleClass="page">
    <padding><Insets top="34" right="42" bottom="34" left="42" /></padding>
    <HBox alignment="CENTER_LEFT"><VBox spacing="4"><Label text="Your categories" styleClass="page-title"/><Label text="Tap into a category to adjust its monthly budget." styleClass="muted"/></VBox><Label HBox.hgrow="ALWAYS"/><Button text="＋ New category" styleClass="primary-button"/></HBox>
    <FlowPane hgap="14" vgap="14"><VBox prefWidth="250" spacing="12" styleClass="category-card"><Label text="Food" styleClass="section-title"/><Label text="184 spent" styleClass="metric-value, small"/><Label text="of 300 budget · 116 left" styleClass="positive"/><ProgressBar maxWidth="Infinity" progress="0.61" styleClass="budget-progress"/><Button text="Edit budget" styleClass="text-button"/></VBox><VBox prefWidth="250" spacing="12" styleClass="category-card"><Label text="Transport" styleClass="section-title"/><Label text="92 spent" styleClass="metric-value, small"/><Label text="of 120 budget · 28 left" styleClass="warning"/><ProgressBar maxWidth="Infinity" progress="0.77" styleClass="budget-progress-warning"/><Button text="Edit budget" styleClass="text-button"/></VBox><VBox prefWidth="250" spacing="12" styleClass="category-card, danger-card"><Label text="Entertainment" styleClass="section-title"/><Label text="197 spent" styleClass="metric-value, small"/><Label text="17 over budget" styleClass="danger"/><ProgressBar maxWidth="Infinity" progress="1.0" styleClass="budget-progress-over"/><Button text="Edit budget" styleClass="text-button"/></VBox><VBox prefWidth="250" spacing="12" styleClass="category-card"><Label text="Bills" styleClass="section-title"/><Label text="0 spent" styleClass="metric-value, small"/><Label text="No budget set" styleClass="muted"/><ProgressBar maxWidth="Infinity" progress="0.0" styleClass="budget-progress"/><Button text="Set budget" styleClass="text-button"/></VBox></FlowPane>
    <VBox spacing="8" styleClass="tip-card"><Label text="Uncategorised expenses" styleClass="section-title"/><Label text="3 expenses still need review. You can reassign them from the Transactions screen." styleClass="muted"/></VBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="shell" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cs3227.prototype.PrototypeController" styleClass="app-shell">
    <left>
        <VBox prefWidth="245" spacing="8" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding><Insets top="28" right="18" bottom="24" left="18" /></padding>
            <Label text="pocketwise" styleClass="brand" />
            <Label text="Student budget tracker" styleClass="sidebar-caption" />
            <Separator />
            <Label text="DASHBOARD PROTOTYPES" styleClass="nav-heading" />
            <Button maxWidth="Infinity" text="A · Summary first" onAction="#showDashboardA" styleClass="nav-button" />
            <Button maxWidth="Infinity" text="B · Visual first" onAction="#showDashboardB" styleClass="nav-button" />
            <Label text="TRANSACTION PROTOTYPES" styleClass="nav-heading" />
            <Button maxWidth="Infinity" text="A · List first" onAction="#showTransactionsA" styleClass="nav-button" />
            <Button maxWidth="Infinity" text="B · Quick entry" onAction="#showTransactionsB" styleClass="nav-button" />
            <Label text="CATEGORY PROTOTYPES" styleClass="nav-heading" />
            <Button maxWidth="Infinity" text="A · Budget rows" onAction="#showCategoriesA" styleClass="nav-button" />
            <Button maxWidth="Infinity" text="B · Category cards" onAction="#showCategoriesB" styleClass="nav-button" />
            <Button maxWidth="Infinity" text="C · Progressive disclosure" onAction="#showCategoriesC" styleClass="nav-button" />
            <VBox VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" text="Data &amp; Settings" onAction="#showSettings" styleClass="nav-button secondary" />
            <Label text="STATIC UI EXPLORATION · v0.1" styleClass="sidebar-footer" />
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" spacing="12" styleClass="empty-state">
            <Label text="Choose a screen prototype" styleClass="empty-title" />
            <Label text="Use the navigation to compare alternative layouts." styleClass="muted" />
        </VBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="20" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" styleClass="page">
    <padding><Insets top="34" right="42" bottom="34" left="42" /></padding>
    <VBox spacing="4"><Label text="Add a transaction" styleClass="page-title"/><Label text="Record it now; refine the category later if needed." styleClass="muted"/></VBox>
    <HBox spacing="14"><Button text="Expense" styleClass="toggle-button selected"/><Button text="Income" styleClass="toggle-button"/></HBox>
    <VBox spacing="14" styleClass="panel form-panel"><Label text="How much?" styleClass="card-label"/><TextField promptText="0.00" styleClass="amount-input"/><Label text="Category" styleClass="card-label"/><TextField promptText="Choose or create a category"/><Label text="Date" styleClass="card-label"/><TextField text="25 Aug 2026"/><Label text="Note (optional)" styleClass="card-label"/><TextField promptText="e.g. lunch at campus"/><Button text="Save expense" styleClass="primary-button"/></VBox>
    <VBox spacing="8" styleClass="tip-card"><Label text="Quick entry" styleClass="section-title"/><Label text="Recent categories: Food · Transport · Entertainment" styleClass="muted"/><Label text="A saved transaction can be edited or deleted later." styleClass="muted"/></VBox>
</VBox>

@startuml
title MoneyMap logical architecture
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam backgroundColor #FFFFFF

package "Application shell" {
  [MoneyMapApp] as App
}

package "JavaFX presentation\ncs3227.moneymap.ui" {
  [ApplicationController] as Shell
  [Screen controllers\nand FXML views] as Ui
}

package "Application/service\ncs3227.moneymap.service" {
  [TransactionService] as Service
  [DataRepository\n<<interface>>] as Repository
}

package "Domain\ncs3227.moneymap.domain" {
  [ApplicationState and\nvalue objects] as Domain
}

package "Persistence\ncs3227.moneymap.persistence" {
  [JsonDataRepository] as Json
  database "data/moneymap.json" as DataFile
}

App --> Shell : constructs
App --> Service : constructs
App --> Json : constructs
Shell --> Ui : loads views
Ui --> Service : invokes use cases
Service --> Domain : creates/query state
Service --> Repository : saves and loads state
Json ..|> Repository : implements
Json --> Domain : maps state
Json --> DataFile : reads/writes

legend right
  Arrow: compile-time/runtime dependency
  Dashed triangle: interface implementation
endlegend
@enduml
